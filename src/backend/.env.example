# Copy to .env and adjust. Defaults in app/config.py already target the legacy snapshot
# (migrated recruit_db on host port 15432).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/recruit_db

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browsers hitting Vite on localhost or 127.0.0.1 (add more origins if needed)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

REDIS_URL=redis://localhost:16379/0
ENVIRONMENT=development
DEBUG=true
