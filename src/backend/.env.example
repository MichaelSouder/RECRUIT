# Copy to .env and adjust. Defaults in app/config.py already target the legacy snapshot
# (migrated recruit_db on host port 15432).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/recruit_db

# Required, 32+ chars, no usable default (app refuses to start otherwise). Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-generated-32-plus-character-random-value

# Required, 32+ chars, no usable default. Encrypts Subject.ssn at rest — generate the same
# way as SECRET_KEY, but keep it a SEPARATE value and back it up separately: losing it makes
# every stored SSN permanently unrecoverable. Generate: openssl rand -hex 32
SSN_ENCRYPTION_KEY=change-me-to-a-different-generated-32-plus-character-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browsers hitting Vite on localhost or 127.0.0.1 (add more origins if needed)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Matches docker-compose.yml's redis service, which requires auth (REDIS_PASSWORD there).
REDIS_URL=redis://:change-me-redis-password@localhost:16379/0
ENVIRONMENT=development
DEBUG=true
