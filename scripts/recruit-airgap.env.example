# Copy this file next to MANIFEST.txt and save as:  recruit-airgap.env
#   cp recruit-airgap.env.example recruit-airgap.env
# Edit values, then run:  ./airgap-stack-up.sh .
#
# Variables already set in your shell take precedence over this file.
# Lines starting with # and blank lines are ignored.
# Optional form: export KEY=value

# --- required ---
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=

# --- recommended for real deployments (scheme + host + port, no path) ---
# CORS_ORIGINS=http://your-server:18080

# --- optional (defaults match AIRGAP_DEPLOY.md) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=recruit_db
# POSTGRES_IMAGE=postgres:15
# REDIS_IMAGE=redis:7-alpine
# POSTGRES_PUBLISH=15432:5432
# REDIS_PUBLISH=16379:6379
# BACKEND_PUBLISH=18000:8000
# FRONTEND_PUBLISH=18080:80
# DOCKER_CMD=podman
# SEED_INITIAL_ADMIN=true
# INITIAL_ADMIN_EMAIL=admin@example.com
# PG_READY_TIMEOUT=120
# STACK_SETTLE_SEC=5
