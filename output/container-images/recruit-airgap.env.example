# Copy next to MANIFEST.txt as:  recruit-airgap.env
#   cp recruit-airgap.env.example recruit-airgap.env
#
# --- Recommended on RHEL / host PostgreSQL (3 containers: redis, backend, frontend) ---
USE_HOST_POSTGRES=true

# Hostname the *backend container* uses to reach PostgreSQL (must match DATABASE_URL).
# Podman: often host.containers.internal
# Docker Desktop: host.docker.internal
# Docker on Linux with host.docker.internal: script adds host-gateway for you.
POSTGRES_SERVICE_HOST=host.containers.internal
POSTGRES_SERVICE_PORT=5432

# Where *this script* checks DB readiness from the host (usually loopback + local pg port).
POSTGRES_WAIT_HOST=127.0.0.1
POSTGRES_WAIT_PORT=5432

# Full URL for the app — same user/password/db as your host PostgreSQL.
# Example (adjust user, password, db name):
# DATABASE_URL=postgresql://postgres:YOURPASSWORD@host.containers.internal:5432/recruit_db

# --- required for stack script ---
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=

# CORS (scheme + host + port, no path)
# CORS_ORIGINS=http://your-server:18080

# --- Set USE_HOST_POSTGRES=false only if you run Postgres in a container (4th container) ---
# USE_HOST_POSTGRES=false
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=recruit_db
# (DATABASE_URL is built automatically as ...@postgres:5432/... when host mode is off)

# --- optional ---
# REDIS_IMAGE=redis:7-alpine
# REDIS_PUBLISH=16379:6379
# BACKEND_PUBLISH=18000:8000
# FRONTEND_PUBLISH=18080:80
# DOCKER_CMD=podman
# PG_READY_TIMEOUT=120
# STACK_SETTLE_SEC=5
