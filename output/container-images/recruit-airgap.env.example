# RECRUIT air-gap stack configuration
# Copy to recruit-airgap.env and fill in the values marked CHANGE_ME.
#
#   cp recruit-airgap.env.example recruit-airgap.env
#   chmod 600 recruit-airgap.env
#
# After the stack is up, load the production database:
#   chmod +x scripts/migration/prod-restore-podman.sh
#   PODMAN_CONTAINER=postgres PGPASSWORD=<POSTGRES_PASSWORD below> \
#     ./scripts/migration/prod-restore-podman.sh


# ---------------------------------------------------------------------------
# Container engine
# ---------------------------------------------------------------------------
DOCKER_CMD=podman


# ---------------------------------------------------------------------------
# Postgres — bundled (runs as a 4th container alongside redis/backend/frontend)
# ---------------------------------------------------------------------------
USE_HOST_POSTGRES=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=recruit_db

# RHEL Podman requires fully-qualified image names (short names like postgres:15
# are rejected by the default short-name policy on RHEL 8/9).
POSTGRES_IMAGE=docker.io/library/postgres:15
REDIS_IMAGE=docker.io/library/redis:7-alpine


# ---------------------------------------------------------------------------
# Application secrets
# Generate SECRET_KEY with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
INITIAL_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password


# ---------------------------------------------------------------------------
# CORS — browser origin(s) allowed to call the API.
# Use exact scheme + host + port as it appears in the browser address bar.
# No trailing slash or path.  Multiple origins: comma-separated.
# Examples:
#   CORS_ORIGINS=http://10.0.1.50:18080
#   CORS_ORIGINS=https://recruit.hospital.local
#   CORS_ORIGINS=http://10.0.1.50:18080,http://localhost:18080
# ---------------------------------------------------------------------------
CORS_ORIGINS=CHANGE_ME_http://YOUR_SERVER_IP_OR_HOSTNAME:18080


# ---------------------------------------------------------------------------
# First-boot admin account (only created when the users table is empty)
# ---------------------------------------------------------------------------
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@example.com


# ---------------------------------------------------------------------------
# Optional port overrides (defaults shown — uncomment only if needed)
# ---------------------------------------------------------------------------
# POSTGRES_PUBLISH=15432:5432
# REDIS_PUBLISH=16379:6379
# BACKEND_PUBLISH=18000:8000
# FRONTEND_PUBLISH=18080:80


# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# PG_READY_TIMEOUT=120
# STACK_SETTLE_SEC=5
